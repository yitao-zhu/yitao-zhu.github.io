<div class="repo repo-profile">
  <a
    class="repo-card repo-profile-card"
    href="https://github.com/{{ include.username }}"
    aria-label="View {{ include.username }} on GitHub"
  >
    <div class="repo-card-top" aria-hidden="true">
      <span class="repo-card-icon repo-profile-icon"><i class="fa-brands fa-github"></i></span>
      <i class="ti ti-arrow-up-right repo-card-arrow"></i>
    </div>
    <div class="repo-card-content">
      <span class="repo-owner">GitHub profile</span>
      <h3>@{{ include.username }}</h3>
      <p>Research code, model implementations, and open-source projects.</p>
    </div>
    <span class="repo-card-link">
      View profile
      <i class="ti ti-arrow-right" aria-hidden="true"></i>
    </span>
  </a>
</div>
