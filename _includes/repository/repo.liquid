{% assign repo_parts = include.repository | split: '/' %}
{% assign repo_owner = repo_parts[0] %}
{% assign repo_name = repo_parts[1] %}
{% assign repo_description = site.data.repositories.repo_descriptions[include.repository] %}
{% assign repo_stars = site.data.repositories.repo_stars[include.repository] | default: 0 %}

<div class="repo">
  <a
    class="repo-card"
    href="https://github.com/{{ include.repository }}"
    aria-label="View {{ include.repository }} on GitHub"
  >
    <div class="repo-card-top">
      <span class="repo-card-icon" aria-hidden="true"><i class="fa-brands fa-github"></i></span>
      <span class="repo-card-actions">
        <span class="repo-stars" title="GitHub stars" data-repository-stars="{{ include.repository }}">
          <i class="ti ti-star-filled" aria-hidden="true"></i>
          <span class="repo-star-count">{{ repo_stars }}</span>
        </span>
        <i class="ti ti-arrow-up-right repo-card-arrow" aria-hidden="true"></i>
      </span>
    </div>
    <div class="repo-card-content">
      <span class="repo-owner">{{ repo_owner }}</span>
      <h3>{{ repo_name }}</h3>
      <p>{{ repo_description | default: 'Open-source research code and resources.' }}</p>
    </div>
    <span class="repo-card-link">
      View repository
      <i class="ti ti-arrow-right" aria-hidden="true"></i>
    </span>
  </a>
</div>
